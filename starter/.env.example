# Local-only connection for the provided Docker Compose setup.
DATABASE_URL=postgresql://day6:day6_local_only@127.0.0.1:55433/day6_lab

# Choose ONE provider if you use an API; local embeddings do not need an API key.
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
EMBEDDING_MODEL=

# Optional experiment controls. Defaults shown are the dev-selected settings.
FIXED_CHUNK_SIZE=800
FIXED_OVERLAP=100
STRUCTURED_CHUNK_SIZE=650
BENCHMARK_SPLIT=all
RESULTS_DIRECTORY=results
USE_HYBRID=1
HYBRID_CANDIDATES=20
HYBRID_DENSE_WEIGHT=0.35
